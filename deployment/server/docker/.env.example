# Vord Fleet — Docker Compose Environment Variables
# Copy this file to .env and fill in all values.

# Container image tag (e.g., "1.3.5" or "latest")
IMAGE_TAG=latest

# Database
# NOTE: placeholder secrets (CHANGE_ME, etc.) are rejected at startup in Production — set real values.
DB_USER=vordfleet
DB_PASSWORD=CHANGE_ME
DB_NAME=vordfleet

# Redis (must be set — Redis requires AUTH; placeholder values are rejected in Production)
REDIS_PASSWORD=CHANGE_ME

# Exposed ports (host:container defaults shown)
API_HTTP_PORT=12233
API_GRPC_PORT=12234
WEB_PORT=5254

# CORS & App (set to your domain, or http://localhost:5254 for local testing)
CORS_ORIGIN=http://localhost:5254
APP_BASE_URL=http://localhost:5254

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OIDC (SSO) — only needed if configuring a custom OIDC provider
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_METADATA_ADDRESS=

# Email — optional. Leave SMTP_HOST empty and every send is skipped; point it at a relay
# (Postfix, a provider's submission endpoint) to have invitations and alerts delivered.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true

# Cookie domain (set if running on a custom domain, e.g., .example.com)
# AUTH_COOKIE_DOMAIN=
