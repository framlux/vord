<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Framlux.Vord.Grpc</RootNamespace>
    <AssemblyName>Framlux.Vord.Grpc</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.9.0</Version>
  </PropertyGroup>

  <!-- The agent wire contracts — registration, configuration and telemetry — and nothing else.
       The internal control-plane contract lives in src/billing-grpc so that agent-facing code
       cannot reach it. This project is deliberately NOT packable: every consumer of the agent
       contracts is inside this repository, and the Go agent generates its own bindings straight
       from the .proto files (see src/agent/Makefile, which passes -I ../grpc/protos). Publishing
       it would ship an assembly that nothing outside the repository restores. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="protos\*.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="protobuf-net.BuildTools" Version="3.2.52" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
