<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.37.24" />
    <!-- Recurring-job inspection is exercised against a real Hangfire storage rather than a
         mocked connection, so the storage-key contract the inspector depends on is proven. -->
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The projection parser reads the wire contract's field names, so its tests build fixtures from
         the generated protobuf types rather than hand-written JSON keys. -->
    <ProjectReference Include="../../../src/grpc/grpc.csproj" />
    <ProjectReference Include="../../../src/services.core/services.core.csproj" />
    <ProjectReference Include="../../shared/shared.csproj" />
  </ItemGroup>

</Project>
