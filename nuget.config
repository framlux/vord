<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org is the only source, deliberately. Every dependency of this repository must be
     restorable with no credentials so a self-hoster can clone and build. Do not add an
     authenticated feed here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
